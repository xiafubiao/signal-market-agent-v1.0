# ===========================================
# Signal Market Agent Configuration Template
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ── 合约地址 (XLayer Testnet) ───────────────────────────────────────────
AGENT_REGISTRY_ADDRESS=
SIGNAL_MARKET_ADDRESS=
PROOF_STORAGE_ADDRESS=
PUBLIC_KEY_REGISTRY=
SIGNAL_ESCROW=

# ── 钱包配置 ───────────────────────────────────────────
PROVIDER_PRIVATE_KEY=
CONSUMER_PRIVATE_KEY=

# ── OKX API (用于 zkTLS 证明) ───────────────────────────────────────────
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# ── Primus zkTLS ───────────────────────────────────────────
PRIMUS_APP_ID=
PRIMUS_APP_SECRET=

# ── LLM (自然语言交互) ───────────────────────────────────────────
LLM_API_KEY=
LLM_MODEL=qwen-plus

# ── 网络配置 ───────────────────────────────────────────
XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon
